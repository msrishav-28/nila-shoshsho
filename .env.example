+# One configuration file for both backends.
# Copy to .env.local, or fill the .env.local already created for you.
# Existing process/hosting environment variables take precedence.
# For isolated staging only. Set the same strong, random value in both services.
STAGING_ACCESS_KEY=
# See backend/CONFIGURATION.md for where to obtain each value.

# Local runtime
NODE_ENV=development
FLASK_ENV=development
FLASK_DEBUG=0
ACCOUNT_PORT=5001
ADVICE_PORT=5002
ACCOUNT_URL=http://127.0.0.1:5001
ADVICE_URL=http://127.0.0.1:5002
CORS_ORIGINS=
TRUSTED_PROXY_CIDRS=

# Accounts and identity
DATABASE_URL=
# Optional owner connection for explicit schema setup. Omit on serving hosts.
DATABASE_MIGRATION_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
STAFF_USER_IDS=
# .env.local has a locally generated encryption key for identifiers and session records. Keep it stable.
GOV_ID_KEY=

# Private document and picture storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared counters and response caches. Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Initial demo allowance. Set a separate monetary ceiling at each provider.
PAID_REQUESTS_PER_DAY=50
DISABLED_ADVICE_PATHS=

# In-app voice
SARVAM_API_KEY=

# Opt-in telephone callback pilot. Leave disabled until test recipients and agent are ready.
BOLNA_CALLBACK_ENABLED=false
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_PHONE_NUMBER=
# Comma-separated account UUID=+91mobile pairs confirmed by the operator.
BOLNA_TEST_RECIPIENTS=
BOLNA_DAILY_LIMIT=5

# Advisors. Configure one or more. Crop photos specifically need Gemini.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Information feeds
DATA_GOV_API_KEY=
SERP_API_KEY=
# Optional integrations requiring verified access
MYSCHEME_API_KEY=
IMD_API_KEY=
