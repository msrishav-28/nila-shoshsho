{
  "errorFields": {
    "account": ["success", "message", "code"],
    "advice": ["error", "code"]
  },
  "failureModes": {
    "400": "Invalid input",
    "401": "Sign-in required or rejected",
    "403": "Access denied",
    "404": "Resource or data unavailable",
    "409": "Conflict",
    "413": "Payload too large",
    "422": "Insufficient evidence or incompatible data",
    "429": "Request limit reached",
    "500": "Internal failure",
    "502": "Upstream failure",
    "503": "Dependency, budget or configuration unavailable"
  },
  "routes": [
    {
      "service": "account",
      "method": "GET",
